# NuP-AIM — variáveis de ambiente (copie para .env, gitignored). NUNCA versione segredos.

# Obrigatório — o app NÃO sobe sem isto (server/routes.ts fail-close)
JWT_SECRET=               # gere com: openssl rand -hex 64  (rotacione o antigo, que vazou)

# Banco
DATABASE_URL=postgresql://user:pass@localhost:5432/nup_aim

# IA (opcional — extração de campos)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# NuPIdentify SSO (opcional — gated por NUPIDENTITY_ENABLED)
NUPIDENTITY_ENABLED=false
NUPIDENTITY_ISSUER=
NUPIDENTITY_CLIENT_ID=
