modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"

# JWT_SECRET removido daqui (estava hardcoded/versionado). Defina-o via
# Replit Secrets (painel Tools > Secrets) ou variável de ambiente — NUNCA no .replit.

[agent]
expertMode = true
integrations = ["javascript_gemini_ai_integrations:1.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 24678
externalPort = 3003

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NuP-AIM Dev"

[[workflows.workflow]]
name = "NuP-AIM Dev"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development PORT=5000 tsx server/index.ts"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production PORT=5000 node dist/index.js"]
build = ["npm", "run", "build"]
